                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <local:MyTextButton Text="查看详情"  FontWeight="Medium" Padding="10,4" Margin="0,0,8,0"
                        EventType="打开网页" EventData="https://docs.yw-games.top/posts/map/done/mimi.html"
